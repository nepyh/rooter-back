# dev

# dev.conf or dev-s3.conf — APP_CONFIG 는 docker-compose.dev.yml 에서만 읽힘
# (로컬 jvm 실행은 ./gradlew run --args="-config=dev-s3.conf" 처럼 인자로 지정)
APP_CONFIG=dev.conf

DB_USER=rooter_dev
DB_PASSWORD=your_db_password
DB_NAME=rooter_dev_db
DB_MAX_POOL_SIZE=10
# 이 속성은 docker-compose.dev.yml 에 의해서 읽히지 않음
# 로컬 jvm 에서 애플리케이션을 돌릴때 읽어오는 용도임
# (개발 환경이지만 컨테이너 네트워크 내부의 호스트 네임을 쓸순 없기에..)
JDBC_URL=your_jdbc_url

JWT_SECRET=your_jwt_secret
JWT_ISSUER=rooter

# 나중에 Gemini/DeepSeek 등 확정되면 채울 것 (지금은 비워둠)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# NICE(나이스 교육정보 개방포털) 인증키 — https://open.neis.go.kr/portal/guide/actKeyPage.do
NICE_API_KEY=your_nice_api_key

# 아래 변수 5개는 dev-s3.conf 를 사용할때 설정해 줘야 하는 값들
# APP_CONFIG 를 dev-s3.conf 로 지정해야 s3 로 뜸 (미설정 시 local 파일 스토리지)
# 아래 ROLESANYWHERE_* 3종 + ./certs 폴더에 클라이언트 인증서(.pem 같은것들)를 준비한 뒤 아래 주석을 해제할 것
#AWS_REGION=ap-northeast-2
#AWS_BUCKET=rooter-dev-bucket
# 리전은 버킷(그리고 Roles Anywhere 자원)이 실제로 있는 리전과 같아야 함 — 다르면 S3 가 301 로 거부함
## Roles Anywhere helper 가 처리할 인증 정보들 (anchor, profile, role)
#ROLESANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:ap-northeast-2:123456789012:trust-anchor/TA_ID
#ROLESANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:ap-northeast-2:123456789012:profile/PROFILE_ID
#ROLESANYWHERE_ROLE_ARN=arn:aws:iam::123456789012:role/my-role

# S3 테스트 설정 (for S3FileStorageSpec test running)
# 값이 없으면 S3FileStorageSpec 테스트는 disabled 처리되어 건너뜀 (gradle test 는 repo 루트 .env 를 읽음)
# 테스트 코드 돌리는거 아니면 냅둬도 됨
TEST_S3_REGION=ap-northeast-2
TEST_S3_BUCKET=rooter-dev-bucket
