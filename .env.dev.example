# dev

# DB settings
DB_USER=rooter_dev
DB_PASSWORD=wapapyrus
DB_NAME=rooter_dev_db
DB_MAX_POOL_SIZE=10

# 이 속성은 docker-compose.dev.yml 에 의해서 읽히지 않음
# 로컬 jvm 에서 애플리케이션을 돌릴때 읽어오는 용도임
# (개발 환경이지만 컨테이너 네트워크 내부의 호스트 네임을 쓸순 없기에..)
JDBC_URL=jdbc:postgresql://localhost:5432/rooter_dev_db

# Storage settings (for s3 storage type)
# 이 값은 스토리지 타입이 local 이라면 그냥 무시됨
AWS_REGION=ap-northeast-2 # ex: Seoul, South Korea region
AWS_BUCKET=rooter-dev-123456789-us-east-1-an
