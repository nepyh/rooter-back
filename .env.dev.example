# dev

DB_USER=rooter_dev
DB_PASSWORD=wapapyrus
DB_NAME=rooter_dev_db
JDBC_URL=jdbc:postgresql://rooter-db.cp8m4cggqxir.ap-northeast-2.rds.amazonaws.com:5432/postgres
DB_MAX_POOL_SIZE=10
JWT_SECRET=qowbnfqlwkfksnalsbalsf123qsda
JWT_ISSUER=rooter
# NICE(나이스 교육정보 개방포털) 인증키 — https://open.neis.go.kr/portal/guide/actKeyPage.do
NICE_API_KEY=your_nice_api_key
# 이 속성은 docker-compose.dev.yml 에 의해서 읽히지 않음
# 로컬 jvm 에서 애플리케이션을 돌릴때 읽어오는 용도임
# (개발 환경이지만 컨테이너 네트워크 내부의 호스트 네임을 쓸순 없기에..)
JDBC_URL=jdbc:postgresql://localhost:5432/rooter_dev_db

# S3 테스트 설정 (for S3FileStorageSpec test running)
# 값이 없으면 S3FileStorageSpec 테스트는 disabled 처리되어 건너뜀 (gradle test 는 repo 루트 .env 를 읽음)
TEST_S3_REGION=ap-northeast-2
TEST_S3_BUCKET=rooter-dev-bucket

# IAM Roles Anywhere (로컬 컨테이너에서 S3 접속용)
# docker compose --profile roles-anywhere up 으로 실행하면 roles-anywhere-helper 서비스가
# 인증서(client-cert.pem/client-key.pem, ./certs/) 기반으로 가짜 IMDS 를 띄우고,
# app 은 AWS_EC2_METADATA_SERVICE_ENDPOINT 로 그걸 읽어 자격증명을 얻음
ROLESANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:ap-northeast-2:123456789012:trust-anchor/TA_ID
ROLESANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:ap-northeast-2:123456789012:profile/PROFILE_ID
ROLESANYWHERE_ROLE_ARN=arn:aws:iam::123456789012:role/my-role

# 로컬 컨테이너를 S3 스토리지로 띄우기 (docker compose --profile roles-anywhere up)
# APP_CONFIG 를 지정하면 app 컨테이너가 dev.conf 대신 dev-s3.conf 로 뜸 (미설정 시 local 파일 스토리지)
# 위의 ROLESANYWHERE_* 3종 + ./certs 에 클라이언트 인증서를 준비한 뒤 아래 주석을 해제할 것
#APP_CONFIG=dev-s3.conf
#AWS_REGION=ap-northeast-2
#AWS_BUCKET=rooter-dev-bucket
