# prod

# docker-compose.prod.yml 의 app 서비스가 사용할 이미지 (ECR 등)
APP_IMAGE=your_image_url

DB_USER=rooter
DB_PASSWORD=wasans
DB_NAME=rooter_db
DB_MAX_POOL_SIZE=10
JDBC_URL=your_jdbc_url

JWT_SECRET=qowbnfqlwkfksnalsbalsf123qsda
JWT_ISSUER=rooter

# NICE(나이스 교육정보 개방포털) 인증키 — https://open.neis.go.kr/portal/guide/actKeyPage.do
NICE_API_KEY=your_nice_api_key

SERVICE_HOST=0.0.0.0
SERVICE_PORT=80

# 콤마 사이에는 공백을 안 넣는걸 권장함
# ALLOWED_HOSTS 에는 오직 hostname 만 들어감. post 나 scheme 같은건 안들어감!
ALLOWED_HOSTS=example.com,example.net

# Storage settings (for s3 storage type)
# 프러덕션 스토리지는 S3 를 사용함 (prod.conf 의 storage.type = s3)
AWS_REGION=ap-northeast-2
AWS_BUCKET=rooter-prod-bucket

# IAM Roles Anywhere (AWS 외부 프러덕션 배포용)
# 이미지에 임베드된 aws_signing_helper 를 credential_process 로 실행해 임시 자격증명을 얻음.
# ./certs 에 client-cert.pem / client-key.pem 를 두어야 하며 (gitignore 대상),
# Trust Anchor 에 등록한 CA 가 발급한 인증서여야 함.
ROLESANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:123456789012:trust-anchor/TA_UUID
ROLESANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:123456789012:profile/PROFILE_UUID
ROLESANYWHERE_ROLE_ARN=arn:aws:iam::123456789012:role/rooter-prod-role
