# prod

# docker-compose.prod.yml 의 app 서비스가 사용할 이미지 (ECR 등)
APP_IMAGE=208367987268.dkr.ecr.ap-northeast-2.amazonaws.com/rooter:latest

DB_USER=rooter
DB_PASSWORD=wasans
DB_NAME=rooter_db
DB_MAX_POOL_SIZE=10
JDBC_URL=jdbc:postgresql://rooter-db.cp8m4cggqxir.ap-northeast-2.rds.amazonaws.com:5432/postgres
JWT_SECRET=qowbnfqlwkfksnalsbalsf123qsda
JWT_ISSUER=rooter
# NICE(나이스 교육정보 개방포털) 인증키 — https://open.neis.go.kr/portal/guide/actKeyPage.do
NICE_API_KEY=your_nice_api_key
# 소셜 로그인 클라이언트 ID (나중에 발급되면 채울 것, 지금은 비워둠)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
SERVICE_HOST=0.0.0.0
SERVICE_PORT=80

# 콤마 사이에는 공백을 안 넣는걸 권장함
# ALLOWED_HOSTS 에는 오직 hostname 만 들어감. post 나 scheme 같은건 안들어감!
ALLOWED_HOSTS=example.com,example.net
