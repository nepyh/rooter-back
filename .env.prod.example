# prod

# DB settings
DB_USER=rooter
DB_PASSWORD=wasans
DB_NAME=rooter_db
DB_MAX_POOL_SIZE=10

# Host, port
SERVICE_HOST=0.0.0.0
SERVICE_PORT=80

# 콤마 사이에는 공백을 안 넣는걸 권장함
# ALLOWED_HOSTS 에는 오직 hostname 만 들어감. post 나 scheme 같은건 안들어감!
ALLOWED_HOSTS=example.com,example.net

# Storage settings (for s3 storage type)
AWS_REGION=ap-northeast-2 # ex: Seoul, South Korea region
AWS_BUCKET=rooter-dev-123456789-us-east-1-an
